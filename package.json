{
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "notivue": "^2.4.5",
    "pinia": "^4.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.1",
    "tesseract.js": "^6.0.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "description": "ToolGlows browser productivity toolkit for Chrome and Firefox",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/lucide": "^1.2.126",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^12.8.2",
    "autoprefixer": "^10.5.4",
    "chalk": "^5.6.2",
    "chrome-types": "^0.1.440",
    "commander": "^13.1.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.24",
    "dotenv": "^16.6.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "postcss-import": "^16.2.0",
    "postcss-preset-env": "^10.6.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^8.2.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "web-ext": "^10.6.0",
    "webext-bridge": "^6.0.1"
  },
  "displayName": "ToolGlows",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "name": "toolglows",
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@babel/helpers@<7.26.10": "7.29.2",
      "@babel/runtime@<7.26.10": "7.29.2",
      "@eslint/plugin-kit@<0.3.4": "0.7.1",
      "@tootallnate/once@<3.0.1": "3.0.1",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=8 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2 <2.1.4": "2.1.4",
      "cross-spawn@<7.0.5": "7.0.6",
      "flatted@<3.4.2": "3.4.2",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@<4.3.1": "4.3.1",
      "lodash@<4.18.0": "4.18.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5 <5.1.8": "5.1.8",
      "minimatch@>=9 <9.0.7": "9.0.7",
      "node-forge@<1.4.0": "1.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "tar@<7.5.21": "7.5.21",
      "tmp@<0.2.4": "0.2.5",
      "yaml@>=2 <2.8.3": "2.8.3"
    },
    "peerDependencyRules": {
      "allowAny": [],
      "allowedDeprecatedVersions": {
        "sourcemap-codec": "1.4.8"
      },
      "allowedVersions": {
        "node-fetch": "*",
        "picomatch": "4.0.7"
      },
      "ignoreMissing": []
    }
  },
  "private": true,
  "securityOverrideNotes": {
    "dependencySecuritySecondPass": "Narrow pnpm overrides for audit advisories in transitive dependency paths: Babel helpers/runtime, ESLint plugin-kit, once, ajv, brace-expansion, cross-spawn, flatted, glob, js-yaml, lodash, minimatch, node-forge, picomatch, tar, tmp, and yaml. The picomatch 4.0.7 peer allowance documents pnpm's stale exact-peer warning from fdir even though fdir declares compatibility with picomatch ^3 or ^4. Remove an override or allowance once the owning direct package resolves without it."
  },
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "cross-env NODE_ENV=production vite build -c vite.chrome.config.ts",
    "build:firefox": "cross-env NODE_ENV=production vite build -c vite.firefox.config.ts",
    "dev": "concurrently \"pnpm run dev:chrome\" \"pnpm run dev:firefox\"",
    "dev:chrome": "cross-env NODE_ENV=development vite -c vite.chrome.config.ts",
    "dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "launch": "tsx scripts/launch.ts",
    "launch:all": "tsx scripts/launch.ts --all",
    "lint": "eslint . --fix --cache",
    "lint:manifest": "web-ext lint --source-dir=dist/firefox --pretty",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}
