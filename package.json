{
  "dependencies": {
    "@formkit/themes": "^1.6.9",
    "@formkit/vue": "^1.6.9",
    "@mozilla/readability": "^0.6.0",
    "@primevue/core": "^4.2.5",
    "@primevue/icons": "^4.2.5",
    "marked": "^15.0.6",
    "notivue": "^2.4.5",
    "pinia": "^2.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.1",
    "tesseract.js": "^6.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.10",
    "vue-router": "^4.5.0",
    "webextension-polyfill": "^0.12.0"
  },
  "description": "A Vue 3 + Vite project for building Chrome extensions",
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "@iconify-json/carbon": "^1.2.5",
    "@iconify-json/fa-solid": "^1.2.1",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/lucide": "^1.2.22",
    "@iconify-json/mdi": "^1.2.2",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.2",
    "@intlify/unplugin-vue-i18n": "^6.0.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "~8.42.3",
    "@types/node": "^22.10.5",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^12.3.0",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.4.1",
    "chrome-types": "^0.1.329",
    "commander": "^13.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.23",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "get-installed-browsers": "^0.1.7",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^28.0.0",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^6.4.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pages": "^0.32.4",
    "vite-plugin-vue-devtools": "^7.7.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.0",
    "web-ext": "^10.1.0",
    "webext-bridge": "^6.0.1"
  },
  "displayName": "Vite Vue 3 Chrome Extension",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "name": "vite-vue3-browser-extension-v3",
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@babel/helpers@<7.26.10": "7.29.2",
      "@babel/runtime@<7.26.10": "7.29.2",
      "@eslint/plugin-kit@<0.3.4": "0.7.1",
      "@tootallnate/once@<3.0.1": "3.0.1",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=8 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2 <2.0.3": "2.0.3",
      "cross-spawn@<7.0.5": "7.0.6",
      "flatted@<3.4.2": "3.4.2",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@<4.1.1": "4.1.1",
      "lodash@<4.18.0": "4.18.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5 <5.1.8": "5.1.8",
      "minimatch@>=9 <9.0.7": "9.0.7",
      "node-forge@<1.4.0": "1.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "@crxjs/vite-plugin>rollup": "2.80.0",
      "tar@<7.5.11": "7.5.11",
      "tmp@<0.2.4": "0.2.5",
      "yaml@>=2 <2.8.3": "2.8.3"
    },
    "peerDependencyRules": {
      "allowAny": [],
      "allowedDeprecatedVersions": {
        "sourcemap-codec": "1.4.8"
      },
      "allowedVersions": {
        "node-fetch": "*"
      },
      "ignoreMissing": []
    }
  },
  "private": true,
  "securityOverrideNotes": {
    "dependencySecuritySecondPass": "Narrow pnpm overrides for audit advisories in transitive dependency paths: Babel helpers/runtime, ESLint plugin-kit, once, ajv, brace-expansion, cross-spawn, flatted, glob, js-yaml, lodash, minimatch, node-forge, picomatch, rollup, tar, tmp, and yaml. Remove an override once the owning direct package resolves to a patched version without it."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mubaidr/vite-vue3-browser-extension-v3"
  },
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "cross-env NODE_ENV=production vite build -c vite.chrome.config.ts",
    "build:firefox": "cross-env NODE_ENV=production vite build -c vite.firefox.config.ts",
    "dev": "concurrently \"pnpm run dev:chrome\" \"pnpm run dev:firefox\"",
    "dev:chrome": "cross-env NODE_ENV=development vite -c vite.chrome.config.ts",
    "dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "launch": "tsx scripts/launch.ts",
    "launch:all": "tsx scripts/launch.ts --all",
    "lint": "eslint . --fix --cache",
    "lint:manifest": "web-ext lint --source-dir=dist/firefox --pretty",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}
